    "When the next player has no moves, the higher score wins." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما لا يملك اللاعب التالي أي نقلات، تفوز النتيجة الأعلى."
