    "Sign in to Game Center in Settings, then choose Play a friend." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الدخول إلى Game Center في الإعدادات، ثم اختر «العب مع صديق»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Влез в Game Center в Настройки, след това избери „Играй с приятел“."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সেটিংস-এ Game Center-এ সাইন ইন করুন, তারপর বন্ধুর সঙ্গে খেলুন বেছে নিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia la sessió al Game Center a Configuració i després tria Jugar amb un amic."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlas se do Game Center v Nastavení a pak zvol Hrát s přítelem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log ind på Game Center i Indstillinger, og vælg derefter Spil mod en ven."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
