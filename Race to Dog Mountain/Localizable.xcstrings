    "Bring your best. I'll bring mine." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعطِني أفضل ما لديك، وسأعطيك أفضل ما لديّ."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дай всичко от себе си. И аз ще дам."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তোমার সেরাটা দাও। আমিও আমার সেরাটা দেব।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dona el millor de tu. Jo faré el mateix."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dej do toho maximum. Já taky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giv dit bedste. Det gør jeg også."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib dein Bestes. Ich gebe meins."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δώσε τον καλύτερό σου εαυτό. Θα δώσω κι εγώ τον δικό μου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da lo mejor de ti. Yo daré lo mejor de mí."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da lo mejor de ti. Yo daré lo mejor de mí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna parastasi. Minä annan omani."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donne le meilleur de toi. Je ferai pareil."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donne le meilleur de toi. Je ferai pareil."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારું શ્રેષ્ઠ લાવો. હું મારું લાવીશ."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תביא/י את המיטב. אני אביא את שלי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना सबसे अच्छा दिखाओ। मैं भी अपना दिखाऊँगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daj sve od sebe. I ja ću."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hozd a legjobbad. Én is hozom az enyémet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keluarkan kemampuan terbaikmu. Aku juga."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dai il meglio di te. Io farò lo stesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全力でおいで。私も全力でいくよ。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Барыңды сал. Мен де барымды салам."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿನ್ನ ಅತ್ಯುತ್ತಮವನ್ನು ತೋರಿಸು. ನಾನೂ ನನ್ನದನ್ನು ತೋರಿಸುತ್ತೇನೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최선을 다해 봐. 나도 그럴게."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parodyk viską, ką gali. Aš irgi parodysiu."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ ഏറ്റവും മികച്ചത് കൊണ്ടുവരൂ. ഞാനും എന്റേത് കൊണ്ടുവരും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुझे सर्वोत्तम दाखव. मीही माझे दाखवेन."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berikan yang terbaik. Saya pun begitu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi alt du har. Det gjør jeg også."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doe je best. Ik doe het mijne."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ତୁମର ସର୍ବୋତ୍ତମ ଦିଅ। ମୁଁ ମୋର ଦେବି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਆਪਣਾ ਸਭ ਤੋਂ ਵਧੀਆ ਲਿਆਓ। ਮੈਂ ਵੀ ਲਿਆਵਾਂਗਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daj z siebie wszystko. Ja też dam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dê o seu melhor. Eu darei o meu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dá o teu melhor. Eu darei o meu."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dă tot ce ai mai bun. Și eu la fel."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покажи всё, на что способен. Я тоже."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daj do toho všetko. Ja tiež."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokaži, kar znaš. Jaz bom tudi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ge ditt bästa. Jag ger mitt."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உன் சிறந்ததைக் கொண்டு வா. நானும் என் சிறந்ததைக் கொண்டு வருவேன்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ ఉత్తమమైనది తీసుకురండి. నేనూ నాది తెస్తాను."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "งัดฝีมือที่ดีที่สุดมาเลย ฉันก็จะทำเหมือนกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En iyini göster. Ben de en iyimi göstereceğim."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покажи все, на що здатний. Я теж покажу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنا بہترین دکھائیں۔ میں بھی اپنا دکھاؤں گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy chơi hết sức. Tôi cũng vậy."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拿出你最好的狀態吧，我也會。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拿出你的最佳状态吧，我也会的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拿出你的最佳狀態吧，我也會的。"
          }
        }
      }
    },
