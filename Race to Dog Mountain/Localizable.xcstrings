    "Your iMessage games live in their conversations. Open a conversation, tap +, then choose Tally Tangle." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توجد ألعاب iMessage الخاصة بك في محادثاتها. افتح محادثة، واضغط على +، ثم اختر Tally Tangle."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Игрите ти в iMessage живеят в разговорите. Отвори разговор, докосни +, след това избери Tally Tangle."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার iMessage গেম তাদের কথোপকথনেই থাকে। একটা কথোপকথন খুলুন, + ট্যাপ করুন, তারপর Tally Tangle বেছে নিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les teves partides d'iMessage són a les seves converses. Obre una conversa, toca + i tria Tally Tangle."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvé hry v iMessage žijí ve svých konverzacích. Otevři konverzaci, klepni na + a vyber Tally Tangle."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine iMessage-spil findes i deres samtaler. Åbn en samtale, tryk på +, og vælg derefter Tally Tangle."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine iMessage-Spiele leben in ihren Konversationen. Öffne eine Konversation, tippe auf + und wähle Tally Tangle."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα παιχνίδια σου στο iMessage βρίσκονται στις συζητήσεις τους. Άνοιξε μια συζήτηση, άγγιξε το + και επίλεξε το Tally Tangle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus partidas de iMessage están en sus conversaciones. Abre una conversación, toca + y elige Tally Tangle."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus partidas de iMessage están en sus conversaciones. Abre una conversación, toca + y elige Tally Tangle."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iMessage-pelisi ovat omissa keskusteluissaan. Avaa keskustelu, napauta + ja valitse Tally Tangle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes parties iMessage se trouvent dans leurs conversations. Ouvre une conversation, touche +, puis choisis Tally Tangle."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes parties iMessage se trouvent dans leurs conversations. Ouvre une conversation, touche +, puis choisis Tally Tangle."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારી iMessage ગેમ તેમની વાતચીતમાં રહે છે. કોઈ વાતચીત ખોલો, + પર ટૅપ કરો, પછી Tally Tangle પસંદ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משחקי iMessage שלך נמצאים בשיחות שלהם. פתח שיחה, הקש על + ובחר ב-Tally Tangle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके iMessage गेम उनकी बातचीत में रहते हैं। कोई बातचीत खोलें, + पर टैप करें, फिर Tally Tangle चुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje iMessage igre žive u svojim razgovorima. Otvori razgovor, dodirni +, zatim odaberi Tally Tangle."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az iMessage-játékaid a beszélgetéseikben vannak. Nyiss meg egy beszélgetést, koppints a + gombra, majd válaszd a Tally Tangle-t."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permainan iMessage-mu ada di percakapannya masing-masing. Buka percakapan, ketuk +, lalu pilih Tally Tangle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue partite iMessage vivono nelle loro conversazioni. Apri una conversazione, tocca +, poi scegli Tally Tangle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iMessageのゲームは各会話の中にあります。会話を開いて＋をタップし、Tally Tangleを選んでください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iMessage ойындарың сөйлесулерде тұрады. Сөйлесуді аш, + түймесін түрт, содан кейін Tally Tangle таңда."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿನ್ನ iMessage ಆಟಗಳು ಅವುಗಳ ಸಂಭಾಷಣೆಗಳಲ್ಲಿವೆ. ಸಂಭಾಷಣೆ ತೆರೆದು, + ಟ್ಯಾಪ್ ಮಾಡಿ, ನಂತರ Tally Tangle ಆರಿಸು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iMessage 게임은 각 대화 안에 있습니다. 대화를 열고 +를 탭한 다음 Tally Tangle을 선택하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavo iMessage žaidimai yra jų pokalbiuose. Atidaryk pokalbį, bakstelėk + ir pasirink Tally Tangle."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ iMessage കളികൾ അവയുടെ സംഭാഷണങ്ങളിലാണ്. ഒരു സംഭാഷണം തുറന്ന് + ടാപ്പ് ചെയ്ത് Tally Tangle തിരഞ്ഞെടുക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुझे iMessage खेळ त्यांच्या संभाषणांमध्ये असतात. संभाषण उघड, + वर टॅप कर, मग Tally Tangle निवड."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permainan iMessage kamu berada dalam perbualan masing-masing. Buka perbualan, ketik +, kemudian pilih Tally Tangle."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iMessage-spillene dine ligger i samtalene sine. Åpne en samtale, trykk på + og velg deretter Tally Tangle."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je iMessage-spellen staan in hun gesprekken. Open een gesprek, tik op + en kies Tally Tangle."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ତୁମର iMessage ଖେଳ ସେମାନଙ୍କ କଥୋପକଥନରେ ରହେ। ଏକ କଥୋପକଥନ ଖୋଲ, + ଟ୍ୟାପ କର, ତା'ପରେ Tally Tangle ବାଛ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਹਾਡੀਆਂ iMessage ਗੇਮਾਂ ਉਨ੍ਹਾਂ ਦੀ ਗੱਲਬਾਤ ਵਿੱਚ ਰਹਿੰਦੀਆਂ ਹਨ। ਕੋਈ ਗੱਲਬਾਤ ਖੋਲ੍ਹੋ, + 'ਤੇ ਟੈਪ ਕਰੋ, ਫਿਰ Tally Tangle ਚੁਣੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje gry w iMessage są w rozmowach. Otwórz rozmowę, stuknij +, a następnie wybierz Tally Tangle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas partidas do iMessage ficam nas conversas. Abra uma conversa, toque em + e escolha Tally Tangle."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As tuas partidas do iMessage estão nas respetivas conversas. Abre uma conversa, toca em + e escolhe Tally Tangle."
