    "Open a conversation with a friend. Tap + and choose Tally Tangle from your Messages apps." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح محادثة مع صديق. اضغط على + واختر Tally Tangle من تطبيقات الرسائل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отвори разговор с приятел. Докосни + и избери Tally Tangle от приложенията в Съобщения."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একজন বন্ধুর সঙ্গে কথোপকথন খুলুন। + ট্যাপ করে আপনার মেসেজ অ্যাপ থেকে Tally Tangle বেছে নিন।"
