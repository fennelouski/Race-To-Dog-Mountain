        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کوئی نہیں سب کچھ ساکن رکھتا ہے۔ آپ کے آلے کی حرکت کم کریں سیٹنگ ہمیشہ لاگو ہوتی ہے۔"
