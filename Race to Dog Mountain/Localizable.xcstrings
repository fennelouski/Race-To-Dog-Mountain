            "value" : "Apabila pemain seterusnya tiada langkah, skor lebih tinggi menang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når neste spiller ikke har flere trekk, vinner den høyeste poengsummen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als de volgende speler geen zetten meer heeft, wint de hoogste score."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ପରବର୍ତ୍ତୀ ଖେଳାଳିଙ୍କର କୌଣସି ଚାଲ ନ ଥିଲେ, ଅଧିକ ସ୍କୋର ଜିତେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਜਦੋਂ ਅਗਲੇ ਖਿਡਾਰੀ ਕੋਲ ਕੋਈ ਚਾਲ ਨਾ ਬਚੇ, ਤਾਂ ਵੱਧ ਸਕੋਰ ਵਾਲਾ ਜਿੱਤਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy następny gracz nie ma ruchów, wygrywa wyższy wynik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
