    "Bigger boards scroll sideways on a phone. A higher limit means smaller tiles." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اللوحات الأكبر تُمرَّر أفقيًا على الهاتف. الحد الأعلى يعني مربعات أصغر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По-големите дъски се превъртат хоризонтално на телефон. По-висок лимит означава по-малки полета."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ফোনে বড় বোর্ড পাশাপাশি স্ক্রল হয়। সীমা বেশি হলে টাইল ছোট হয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els taulers més grans es desplacen de costat en un telèfon. Un límit més alt vol dir caselles més petites."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Větší desky se na telefonu posouvají do stran. Vyšší limit znamená menší políčka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Større brætter rulles sidelæns på en telefon. En højere grænse giver mindre felter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Größere Bretter scrollen auf dem Telefon seitlich. Ein höheres Limit bedeutet kleinere Felder."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα μεγαλύτερα ταμπλό κάνουν κύλιση στο πλάι στο τηλέφωνο. Υψηλότερο όριο σημαίνει μικρότερα τετράγωνα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los tableros más grandes se desplazan de lado en un teléfono. Un límite más alto significa casillas más pequeñas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los tableros más grandes se desplazan de lado en un teléfono. Un límite más alto significa casillas más pequeñas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isommat laudat vierivät sivuttain puhelimessa. Suurempi raja tarkoittaa pienempiä ruutuja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les grands plateaux défilent horizontalement sur un téléphone. Une limite plus haute donne des cases plus petites."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les grands plateaux défilent horizontalement sur un téléphone. Une limite plus haute donne des cases plus petites."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "મોટાં બોર્ડ ફોન પર આડાં સ્ક્રોલ થાય છે. વધુ મર્યાદા એટલે નાનાં ખાનાં."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לוחות גדולים יותר נגללים הצידה בטלפון. מגבלה גבוהה יותר פירושה משבצות קטנות יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोन पर बड़े बोर्ड बगल में स्क्रॉल होते हैं। ज़्यादा सीमा का मतलब छोटे खाने।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veće ploče na telefonu se pomiču vodoravno. Viša granica znači manja polja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nagyobb táblák telefonon oldalra görgethetők. Magasabb határ kisebb mezőket jelent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Papan yang lebih besar bergulir ke samping di ponsel. Batas yang lebih tinggi berarti petak yang lebih kecil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su un telefono i tabelloni più grandi scorrono di lato. Un limite più alto significa caselle più piccole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大きいボードはスマートフォンでは横にスクロールします。上限を高くするとタイルが小さくなります。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Үлкен тақталар телефонда көлденең айналады. Шек жоғары болса, шаршылар кішірейеді."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ದೊಡ್ಡ ಬೋರ್ಡ್‌ಗಳು ಫೋನ್‌ನಲ್ಲಿ ಪಕ್ಕಕ್ಕೆ ಸ್ಕ್ರಾಲ್ ಆಗುತ್ತವೆ. ಹೆಚ್ಚಿನ ಮಿತಿ ಎಂದರೆ ಚಿಕ್ಕ ಚೌಕಗಳು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "큰 보드는 휴대폰에서 옆으로 스크롤됩니다. 한도가 높을수록 타일이 작아집니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefone didesnės lentos slenka į šoną. Didesnė riba reiškia mažesnius langelius."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വലിയ ബോർഡുകൾ ഫോണിൽ വശത്തേക്ക് സ്ക്രോൾ ചെയ്യും. ഉയർന്ന പരിധി എന്നാൽ ചെറിയ കള്ളികൾ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मोठे बोर्ड फोनवर आडवे स्क्रोल होतात. जास्त मर्यादा म्हणजे लहान चौकोन."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Papan yang lebih besar menatal ke sisi pada telefon. Had yang lebih tinggi bermaksud petak yang lebih kecil."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Større brett rulles sidelengs på telefon. En høyere grense gir mindre ruter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grotere borden scrollen op een telefoon zijwaarts. Een hogere limiet betekent kleinere tegels."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଫୋନରେ ବଡ଼ ବୋର୍ଡ ପାର୍ଶ୍ୱକୁ ସ୍କ୍ରୋଲ ହୁଏ। ଅଧିକ ସୀମା ମାନେ ଛୋଟ ଟାଇଲ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਫ਼ੋਨ 'ਤੇ ਵੱਡੇ ਬੋਰਡ ਪਾਸੇ ਵੱਲ ਸਕ੍ਰੋਲ ਹੁੰਦੇ ਹਨ। ਵੱਧ ਸੀਮਾ ਦਾ ਮਤਲਬ ਛੋਟੀਆਂ ਟਾਈਲਾਂ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Większe plansze przewijają się w bok na telefonie. Wyższy limit oznacza mniejsze pola."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabuleiros maiores rolam para o lado no celular. Um limite maior deixa as casas menores."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabuleiros maiores deslizam para o lado num telemóvel. Um limite maior torna as casas mais pequenas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tablele mai mari derulează lateral pe telefon. O limită mai mare înseamnă pătrățele mai mici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На телефоне большие поля прокручиваются вбок. Чем выше предел, тем меньше клетки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väčšie dosky sa na telefóne posúvajú do strany. Vyšší limit znamená menšie políčka."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Večje plošče se na telefonu pomikajo vstran. Višja meja pomeni manjša polja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Större brädor rullar i sidled på en telefon. En högre gräns ger mindre rutor."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பெரிய பலகைகள் போனில் பக்கவாட்டில் நகரும். அதிக வரம்பு என்றால் சிறிய கட்டங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పెద్ద బోర్డులు ఫోన్‌లో పక్కకు స్క్రోల్ అవుతాయి. ఎక్కువ పరిమితి అంటే చిన్న గడులు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กระดานที่ใหญ่ขึ้นจะเลื่อนด้านข้างบนโทรศัพท์ ขีดจำกัดที่สูงขึ้นหมายถึงช่องที่เล็กลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Büyük tahtalar telefonda yana kayar. Daha yüksek sınır, daha küçük kareler demektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Великі поля на телефоні прокручуються вбік. Що більше обмеження, то менші клітинки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بڑے بورڈ فون پر دائیں بائیں اسکرول ہوتے ہیں۔ زیادہ حد کا مطلب چھوٹے خانے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bàn lớn hơn sẽ cuộn ngang trên điện thoại. Giới hạn càng cao thì ô càng nhỏ."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "較大的棋盤在手機上可橫向捲動。上限越高，格子越細。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "较大的棋盘在手机上可横向滚动。上限越高，格子越小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "較大的棋盤在手機上可橫向捲動。上限越高，格子越小。"
          }
        }
      }
