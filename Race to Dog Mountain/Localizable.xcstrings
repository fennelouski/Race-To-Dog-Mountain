          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உன் முதல் எண்ணைத் தேர்ந்தெடுத்து, பலகையை உன் செய்தியில் சேர். உன் நண்பர் பலகையைத் தட்டித் தன் முறையை விளையாடுவார்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ మొదటి అంకెను ఎంచుకుని బోర్డును మీ సందేశానికి జోడించండి. మీ స్నేహితులు తమ వంతు ఆడటానికి బోర్డును ట్యాప్ చేస్తారు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกตัวเลขแรกแล้วเพิ่มกระดานลงในข้อความ เพื่อนของคุณแตะกระดานเพื่อเล่นตาของเขา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk sayını seç ve tahtayı mesajına ekle. Arkadaşın sırasını oynamak için tahtaya dokunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вибери перше число й додай поле до повідомлення. Друг торкнеться поля, щоб зробити хід."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنا پہلا نمبر چنیں اور بورڈ کو اپنے پیغام میں شامل کریں۔ آپ کا دوست اپنی باری کے لیے بورڈ پر ٹیپ کرے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn số đầu tiên và thêm bàn vào tin nhắn. Bạn của bạn chạm vào bàn để đi lượt của họ."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選好第一個數字，然後把棋盤加入訊息中。朋友輕按棋盤即可進行他們的回合。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选好第一个数字，然后把棋盘添加到信息中。好友轻点棋盘即可进行他们的回合。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選好第一個數字，然後把棋盤加入訊息中。朋友點一下棋盤即可進行他們的回合。"
          }
        }
      }
    },
