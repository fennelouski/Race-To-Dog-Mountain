    "None keeps everything still. Your device’s Reduce Motion setting always applies." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خيار «بلا» يُبقي كل شيء ثابتًا. يُطبَّق دائمًا إعداد «تقليل الحركة» في جهازك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Без“ спира всяко движение. Настройката „Намаляване на движението“ на устройството винаги се прилага."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনোটি নয় বেছে নিলে সব স্থির থাকে। আপনার ডিভাইসের মোশন কমানোর সেটিং সবসময় প্রযোজ্য।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cap ho manté tot quiet. Sempre s'aplica l'opció Reduir el moviment del dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádná nechá vše v klidu. Nastavení Omezit pohyb na tvém zařízení platí vždy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen holder alt i ro. Din enheds indstilling Reducer bevægelse gælder altid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Keine“ hält alles still. Die Einstellung „Bewegung reduzieren“ deines Geräts gilt immer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επιλογή «Καμία» κρατά τα πάντα ακίνητα. Η ρύθμιση «Μείωση κίνησης» της συσκευής σου ισχύει πάντα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna lo mantiene todo quieto. El ajuste Reducir movimiento de tu dispositivo siempre se aplica."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna mantiene todo quieto. La opción Reducir movimiento de tu dispositivo siempre se aplica."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei mitään pitää kaiken paikallaan. Laitteesi Vähennä liikettä -asetus on aina voimassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune garde tout immobile. Le réglage Réduire les animations de ton appareil s’applique toujours."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune garde tout immobile. Le réglage Réduire les animations de ton appareil s’applique toujours."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કોઈ નહીં બધું સ્થિર રાખે છે. તમારા ડિવાઇસની ગતિ ઓછી કરો સેટિંગ હંમેશાં લાગુ રહે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "״ללא״ משאיר הכול דומם. הגדרת ״הפחתת תנועה״ במכשיר שלך חלה תמיד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई नहीं सब कुछ स्थिर रखता है। आपके डिवाइस की मोशन कम करें सेटिंग हमेशा लागू रहती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez drži sve mirnim. Postavka Smanji kretanje na tvom uređaju uvijek vrijedi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Nincs mindent mozdulatlanul hagy. Az eszközöd Mozgás csökkentése beállítása mindig érvényes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada membuat semuanya diam. Pengaturan Kurangi Gerakan di perangkatmu selalu berlaku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna tiene tutto fermo. L’impostazione Riduci movimento del dispositivo vale sempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「なし」ではすべて静止します。デバイスの「視差効果を減らす」設定は常に適用されます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Жоқ» барлығын қозғалыссыз қалдырады. Құрылғыдағы «Қозғалысты азайту» параметрі әрқашан қолданылады."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಯಾವುದೂ ಇಲ್ಲ ಆಯ್ಕೆಯು ಎಲ್ಲವನ್ನೂ ಸ್ಥಿರವಾಗಿಡುತ್ತದೆ. ನಿನ್ನ ಸಾಧನದ ಚಲನೆ ಕಡಿಮೆಮಾಡಿ ಸೆಟ್ಟಿಂಗ್ ಯಾವಾಗಲೂ ಅನ್ವಯಿಸುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘없음’은 모든 것을 정지 상태로 유지합니다. 기기의 ‘동작 줄이기’ 설정은 항상 적용됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Nėra“ viską palieka nejudantį. Įrenginio nustatymas „Mažinti judesį“ taikomas visada."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒന്നുമില്ല എല്ലാം നിശ്ചലമാക്കുന്നു. ഉപകരണത്തിലെ ചലനം കുറയ്ക്കുക ക്രമീകരണം എപ്പോഴും ബാധകമാണ്."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘काहीही नाही’ सर्व काही स्थिर ठेवते. तुझ्या डिव्हाइसचे ‘हालचाल कमी करा’ सेटिंग नेहमी लागू होते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada memastikan semuanya pegun. Seting Kurangkan Gerakan perantimu sentiasa digunakan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen holder alt i ro. Enhetens innstilling for Reduser bevegelse gjelder alltid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met ‘Geen’ staat alles stil. De instelling ‘Verminder beweging’ van je apparaat geldt altijd."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କିଛି ନାହିଁ ସବୁକିଛି ସ୍ଥିର ରଖେ। ତୁମ ଡିଭାଇସର ଗତି କମାଅ ସେଟିଂ ସର୍ବଦା ଲାଗୁ ହୁଏ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਕੋਈ ਨਹੀਂ ਸਭ ਕੁਝ ਸਥਿਰ ਰੱਖਦਾ ਹੈ। ਤੁਹਾਡੇ ਡਿਵਾਈਸ ਦੀ ਮੋਸ਼ਨ ਘਟਾਓ ਸੈਟਿੰਗ ਹਮੇਸ਼ਾ ਲਾਗੂ ਹੁੰਦੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Brak” zatrzymuje wszystkie animacje. Ustawienie „Ogranicz ruch” na urządzeniu zawsze obowiązuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma deixa tudo parado. O ajuste Reduzir Movimento do dispositivo sempre se aplica."
