    "Fonsters are drawn from each name. Pictures shows painted portraits for computer rivals." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُرسم Fonsters من كل اسم. يعرض خيار «الصور» صورًا مرسومة لمنافسي الكمبيوتر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters се рисуват от всяко име. „Портрети“ показва рисувани портрети на компютърните съперници."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি নাম থেকে Fonsters আঁকা হয়। ছবি বিকল্পে কম্পিউটার প্রতিদ্বন্দ্বীদের আঁকা প্রতিকৃতি দেখায়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els Fonsters es dibuixen a partir de cada nom. Imatges mostra retrats pintats per als rivals de l'ordinador."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters se kreslí podle každého jména. Obrázky zobrazují malované portréty počítačových soupeřů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters tegnes ud fra hvert navn. Billeder viser malede portrætter af computermodstandere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters werden aus jedem Namen gezeichnet. „Bilder“ zeigt gemalte Porträts für Computergegner."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα Fonsters σχεδιάζονται από κάθε όνομα. Η επιλογή «Εικόνες» δείχνει ζωγραφισμένα πορτρέτα για τους αντιπάλους υπολογιστή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los Fonsters se dibujan a partir de cada nombre. Imágenes muestra retratos pintados para los rivales del ordenador."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los Fonsters se dibujan a partir de cada nombre. Imágenes muestra retratos pintados para los rivales de la computadora."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters piirretään kunkin nimen pohjalta. Kuvat näyttää maalatut muotokuvat tietokonevastustajille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Fonsters sont dessinés à partir de chaque nom. Images affiche des portraits peints pour les adversaires ordinateur."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Fonsters sont dessinés à partir de chaque nom. Images affiche des portraits peints pour les adversaires ordinateur."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters દરેક નામ પરથી દોરવામાં આવે છે. ચિત્રો કમ્પ્યુટર હરીફો માટે રંગેલાં ચિત્રો બતાવે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ה-Fonsters מצוירים לפי כל שם. ״תמונות״ מציג דיוקנאות מצוירים ליריבי המחשב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters हर नाम से बनाए जाते हैं। चित्र कंप्यूटर प्रतिद्वंद्वियों के लिए पेंट किए गए पोर्ट्रेट दिखाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters se crtaju prema svakom imenu. Slike prikazuju naslikane portrete za računalne suparnike."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Fonsters lények minden névből készülnek. A Képek festett portrékat mutat a gépi ellenfeleknél."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters digambar dari setiap nama. Gambar menampilkan potret lukisan untuk lawan komputer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Fonsters nascono da ogni nome. Immagini mostra ritratti dipinti per gli avversari computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonstersは名前ごとに描かれます。「ポートレート」では、コンピュータの対戦相手を描いた肖像画が表示されます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters әр есімнен салынады. «Суреттер» компьютер қарсыластарының салынған портреттерін көрсетеді."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters ಪ್ರತಿ ಹೆಸರಿನಿಂದ ರಚಿಸಲ್ಪಡುತ್ತವೆ. ಚಿತ್ರಗಳು ಕಂಪ್ಯೂಟರ್ ಎದುರಾಳಿಗಳ ಬಣ್ಣದ ಭಾವಚಿತ್ರಗಳನ್ನು ತೋರಿಸುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters는 각 이름으로부터 그려집니다. 초상화는 컴퓨터 상대의 그림 초상화를 보여 줍니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters nupiešiami pagal kiekvieną vardą. Paveikslėliai rodo pieštus kompiuterio varžovų portretus."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഓരോ പേരിൽ നിന്നും Fonsters വരയ്ക്കപ്പെടുന്നു. ചിത്രങ്ങൾ കമ്പ്യൂട്ടർ എതിരാളികളുടെ വരച്ച ഛായാചിത്രങ്ങൾ കാണിക്കുന്നു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters प्रत्येक नावावरून रेखाटले जातात. चित्रे संगणक प्रतिस्पर्ध्यांची रंगवलेली व्यक्तिचित्रे दाखवते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters dilukis daripada setiap nama. Gambar menunjukkan potret berlukis untuk pesaing komputer."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters tegnes ut fra hvert navn. Bilder viser malte portretter av datamaskinmotstandere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters worden getekend op basis van elke naam. Afbeeldingen toont geschilderde portretten van computertegenstanders."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters ପ୍ରତ୍ୟେକ ନାମରୁ ଅଙ୍କାଯାଏ। ଛବିଗୁଡ଼ିକ କମ୍ପ୍ୟୁଟର ପ୍ରତିଦ୍ୱନ୍ଦ୍ୱୀଙ୍କ ପାଇଁ ରଙ୍ଗିନ ପୋର୍ଟ୍ରେଟ ଦେଖାଏ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters ਹਰ ਨਾਮ ਤੋਂ ਬਣਾਏ ਜਾਂਦੇ ਹਨ। ਤਸਵੀਰਾਂ ਕੰਪਿਊਟਰ ਵਿਰੋਧੀਆਂ ਲਈ ਪੇਂਟ ਕੀਤੇ ਪੋਰਟਰੇਟ ਦਿਖਾਉਂਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters powstają z każdego imienia. „Portrety” pokazują malowane portrety rywali komputerowych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os Fonsters são desenhados a partir de cada nome. Imagens mostra retratos pintados para os rivais do computador."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os Fonsters são desenhados a partir de cada nome. Imagens mostra retratos pintados para os rivais do computador."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters sunt desenați pornind de la fiecare nume. Imagini afișează portrete pictate pentru adversarii calculator."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters рисуются по каждому имени. «Портреты» показывают рисованные портреты компьютерных соперников."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters sa kreslia podľa každého mena. Obrázky zobrazujú maľované portréty počítačových súperov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters se narišejo iz vsakega imena. Slike prikažejo naslikane portrete računalniških tekmecev."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters ritas utifrån varje namn. Bilder visar målade porträtt av datormotståndare."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters ஒவ்வொரு பெயரிலிருந்தும் வரையப்படுகின்றன. படங்கள் கணினி போட்டியாளர்களுக்கு வரைந்த உருவப்படங்களைக் காட்டும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters ప్రతి పేరు నుండి గీయబడతాయి. చిత్రాలు కంప్యూటర్ ప్రత్యర్థులకు చిత్రించిన చిత్తరువులను చూపుతుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters ถูกวาดจากชื่อของแต่ละคน รูปภาพจะแสดงภาพเหมือนที่วาดไว้สำหรับคู่แข่งคอมพิวเตอร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters her isimden çizilir. Resimler, bilgisayar rakipleri için boyanmış portreler gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters малюються з кожного імені. «Портрети» показує мальовані портрети комп’ютерних суперників."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters ہر نام سے بنائے جاتے ہیں۔ تصاویر کمپیوٹر حریفوں کے لیے پینٹ کیے گئے پورٹریٹ دکھاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters được vẽ từ mỗi cái tên. Hình ảnh hiển thị chân dung vẽ tay cho các đối thủ máy."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonsters 按每個名字生成。「肖像」會為電腦對手顯示手繪肖像。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
