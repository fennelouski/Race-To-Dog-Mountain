    "Play a computer on this device. Tap its player card to choose a level." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العب ضد الكمبيوتر على هذا الجهاز. اضغط على بطاقة اللاعب الخاصة به لاختيار مستوى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Играй срещу компютъра на това устройство. Докосни картата му, за да избереш ниво."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ডিভাইসে কম্পিউটারের সঙ্গে খেলুন। লেভেল বাছতে তার প্লেয়ার কার্ডে ট্যাপ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juga contra l'ordinador en aquest dispositiu. Toca la seva targeta de jugador per triar un nivell."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hraj proti počítači na tomto zařízení. Úroveň vybereš klepnutím na jeho kartu hráče."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spil mod computeren på denne enhed. Tryk på dens spillerkort for at vælge et niveau."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiele auf diesem Gerät gegen den Computer. Tippe auf seine Spielerkarte, um eine Stufe zu wählen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παίξε με τον υπολογιστή σε αυτήν τη συσκευή. Άγγιξε την κάρτα παίκτη του για να επιλέξεις επίπεδο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juega contra el ordenador en este dispositivo. Toca su tarjeta de jugador para elegir un nivel."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juega contra la computadora en este dispositivo. Toca su tarjeta de jugador para elegir un nivel."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pelaa tietokonetta vastaan tällä laitteella. Valitse taso napauttamalla sen pelaajakorttia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affronte l’ordinateur sur cet appareil. Touche sa carte de joueur pour choisir un niveau."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affronte l’ordinateur sur cet appareil. Touche sa carte de joueur pour choisir un niveau."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ ડિવાઇસ પર કમ્પ્યુટર સામે રમો. લેવલ પસંદ કરવા તેના ખેલાડી કાર્ડ પર ટૅપ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שחק נגד המחשב במכשיר הזה. הקש על כרטיס השחקן שלו כדי לבחור רמה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस पर कंप्यूटर से खेलें। लेवल चुनने के लिए उसके प्लेयर कार्ड पर टैप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igraj protiv računala na ovom uređaju. Dodirni njegovu karticu igrača za odabir razine."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Játssz a gép ellen ezen az eszközön. A szint kiválasztásához koppints a játékoskártyájára."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lawan komputer di perangkat ini. Ketuk kartu pemainnya untuk memilih level."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gioca contro il computer su questo dispositivo. Tocca la sua scheda giocatore per scegliere un livello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスでコンピュータと対戦します。プレイヤーカードをタップしてレベルを選んでください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осы құрылғыда компьютермен ойна. Деңгейді таңдау үшін оның ойыншы картасын түрт."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ಸಾಧನದಲ್ಲಿ ಕಂಪ್ಯೂಟರ್ ಜೊತೆ ಆಡು. ಹಂತ ಆರಿಸಲು ಅದರ ಆಟಗಾರ ಕಾರ್ಡ್ ಟ್ಯಾಪ್ ಮಾಡು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 컴퓨터와 플레이합니다. 플레이어 카드를 탭해 레벨을 선택하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žaisk su kompiuteriu šiame įrenginyje. Bakstelėk jo žaidėjo kortelę, kad pasirinktum lygį."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ ഉപകരണത്തിൽ കമ്പ്യൂട്ടറുമായി കളിക്കുക. ലെവൽ തിരഞ്ഞെടുക്കാൻ അതിന്റെ പ്ലെയർ കാർഡ് ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या डिव्हाइसवर संगणकाशी खेळ. स्तर निवडण्यासाठी त्याच्या खेळाडू कार्डवर टॅप कर."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lawan komputer pada peranti ini. Ketik kad pemainnya untuk memilih tahap."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spill mot datamaskinen på denne enheten. Trykk på spillerkortet for å velge et nivå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speel tegen de computer op dit apparaat. Tik op de spelerskaart om een niveau te kiezen."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହି ଡିଭାଇସରେ କମ୍ପ୍ୟୁଟର ସହ ଖେଳ। ସ୍ତର ବାଛିବାକୁ ତାର ଖେଳାଳି କାର୍ଡ ଟ୍ୟାପ କର।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਸ ਡਿਵਾਈਸ 'ਤੇ ਕੰਪਿਊਟਰ ਨਾਲ ਖੇਡੋ। ਲੈਵਲ ਚੁਣਨ ਲਈ ਉਸ ਦੇ ਖਿਡਾਰੀ ਕਾਰਡ 'ਤੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zagraj z komputerem na tym urządzeniu. Stuknij jego kartę gracza, aby wybrać poziom."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jogue contra o computador neste dispositivo. Toque no cartão do jogador para escolher um nível."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joga contra o computador neste dispositivo. Toca no cartão do jogador para escolher um nível."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joacă împotriva calculatorului pe acest dispozitiv. Atinge cardul lui de jucător pentru a alege un nivel."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сыграй с компьютером на этом устройстве. Коснись его карточки, чтобы выбрать уровень."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hraj proti počítaču na tomto zariadení. Úroveň vyberieš klepnutím na jeho kartu hráča."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igraj proti računalniku na tej napravi. Za izbiro stopnje tapni njegovo kartico igralca."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spela mot datorn på den här enheten. Tryck på dess spelarkort för att välja en nivå."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தச் சாதனத்தில் கணினியுடன் விளையாடு. நிலையைத் தேர்ந்தெடுக்க அதன் ஆட்டக்காரர் அட்டையைத் தட்டு."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఈ పరికరంలో కంప్యూటర్‌తో ఆడండి. స్థాయిని ఎంచుకోవడానికి దాని ఆటగాడి కార్డును ట్యాప్ చేయండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เล่นกับคอมพิวเตอร์บนอุปกรณ์นี้ แตะการ์ดผู้เล่นเพื่อเลือกระดับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihazda bilgisayara karşı oyna. Seviye seçmek için oyuncu kartına dokun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зіграй з компʼютером на цьому пристрої. Торкнися його картки, щоб вибрати рівень."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس ڈیوائس پر کمپیوٹر سے کھیلیں۔ لیول چننے کے لیے اس کے پلیئر کارڈ پر ٹیپ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chơi với máy trên thiết bị này. Chạm vào thẻ người chơi của máy để chọn cấp độ."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在這部裝置上與電腦對戰。輕按電腦的玩家卡片即可選擇等級。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在这台设备上与电脑对战。轻点电脑的玩家卡片可选择等级。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在這部裝置上與電腦對戰。點一下電腦的玩家卡片即可選擇等級。"
          }
        }
      }
    },
    "Play a friend" : {
      "localizations" : {
