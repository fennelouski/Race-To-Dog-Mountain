    "Saved games couldn't be read. The original data has been kept." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة الألعاب المحفوظة. تم الاحتفاظ بالبيانات الأصلية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запазените игри не можаха да се прочетат. Оригиналните данни са запазени."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সেভ করা গেম পড়া যায়নি। মূল ডেটা রেখে দেওয়া হয়েছে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'han pogut llegir les partides desades. S'han conservat les dades originals."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložené hry se nepodařilo načíst. Původní data zůstala zachována."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
