    "Shows static score and turn changes instead of movement. Your device’s Reduce Motion setting is always respected." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض تغييرات النتيجة والدور بشكل ثابت بدلًا من الحركة. يتم دائمًا احترام إعداد «تقليل الحركة» في جهازك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показва статични промени в резултата и хода вместо движение. Настройката „Намаляване на движението“ на устройството винаги се спазва."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নড়াচড়ার বদলে স্কোর ও পালার পরিবর্তন স্থিরভাবে দেখায়। আপনার ডিভাইসের “মোশন কমান” সেটিং সবসময় মেনে চলা হয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra els canvis de puntuació i de torn sense moviment. Sempre es respecta l'opció Reduir el moviment del teu dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Místo pohybu zobrazuje statické změny skóre a tahů. Nastavení Omezit pohyb na tvém zařízení je vždy respektováno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser statiske point og turskift i stedet for bevægelse. Din enheds indstilling Reducer bevægelse respekteres altid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt Punktestand und Zugwechsel statisch statt mit Bewegung. Die Einstellung „Bewegung reduzieren“ deines Geräts wird immer berücksichtigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζει στατικές αλλαγές σκορ και σειράς αντί για κίνηση. Η ρύθμιση «Μείωση κίνησης» της συσκευής σου τηρείται πάντα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra los cambios de puntuación y de turno sin movimiento. Siempre se respeta el ajuste Reducir movimiento de tu dispositivo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra los cambios de puntuación y de turno sin movimiento. Siempre se respeta la configuración Reducir movimiento de tu dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää pisteet ja vuoronvaihdot ilman liikettä. Laitteen Vähennä liikettä -asetusta noudatetaan aina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche le score et les changements de tour sans mouvement. Le réglage Réduire les animations de ton appareil est toujours respecté."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche le score et les changements de tour sans mouvement. Le réglage Réduire les animations de ton appareil est toujours respecté."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "હલનચલનને બદલે સ્કોર અને વારાના ફેરફારો સ્થિર રીતે બતાવે છે. તમારા ડિવાઇસનું “ગતિ ઘટાડો” સેટિંગ હંમેશાં માન્ય રખાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מציג שינויי ניקוד ותור באופן סטטי במקום בתנועה. ההגדרה ״הפחתת תנועה״ במכשיר שלך תמיד מכובדת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हलचल की जगह स्कोर और बारी के बदलाव स्थिर रूप में दिखाता है। आपके डिवाइस की “मोशन कम करें” सेटिंग का हमेशा पालन होता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umjesto kretanja prikazuje statične promjene rezultata i poteza. Postavka Smanji kretanje na tvom uređaju uvijek se poštuje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mozgás helyett statikusan jeleníti meg a pontszám és a kör változásait. Az eszközöd Mozgás csökkentése beállítását mindig figyelembe veszi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan skor dan pergantian giliran secara statis tanpa gerakan. Pengaturan Kurangi Gerakan perangkatmu selalu dipatuhi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra punteggio e cambi di turno statici invece del movimento. L’impostazione Riduci movimento del dispositivo viene sempre rispettata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動きの代わりに、スコアとターンの変化を静的に表示します。デバイスの「視差効果を減らす」設定は常に優先されます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қозғалыс орнына ұпай мен кезек өзгерістерін статикалық түрде көрсетеді. Құрылғыдағы «Қозғалысты азайту» параметрі әрқашан ескеріледі."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಚಲನೆಯ ಬದಲು ಸ್ಥಿರ ಅಂಕ ಮತ್ತು ಸರದಿ ಬದಲಾವಣೆಗಳನ್ನು ತೋರಿಸುತ್ತದೆ. ನಿನ್ನ ಸಾಧನದ ಚಲನೆ ಕಡಿಮೆಮಾಡಿ ಸೆಟ್ಟಿಂಗ್ ಅನ್ನು ಯಾವಾಗಲೂ ಗೌರವಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "움직임 대신 점수와 차례 변화를 정적으로 표시합니다. 기기의 ‘동작 줄이기’ 설정은 항상 적용됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rodo statinius taškus ir ėjimų kaitą be judesio. Įrenginio nustatymo „Mažinti judesį“ visada paisoma."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ചലനത്തിന് പകരം നിശ്ചല സ്കോറും ഊഴമാറ്റങ്ങളും കാണിക്കുന്നു. ഉപകരണത്തിലെ ചലനം കുറയ്ക്കുക ക്രമീകരണം എപ്പോഴും പാലിക്കപ്പെടും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हालचालीऐवजी स्थिर गुण आणि पाळीतील बदल दाखवते. तुझ्या डिव्हाइसचे ‘हालचाल कमी करा’ सेटिंग नेहमी पाळले जाते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menunjukkan skor dan pertukaran giliran secara statik tanpa gerakan. Seting Kurangkan Gerakan perantimu sentiasa dipatuhi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser statisk poengsum og turbytter i stedet for bevegelse. Enhetens innstilling for Reduser bevegelse respekteres alltid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont score en beurtwissels statisch in plaats van met beweging. De instelling ‘Verminder beweging’ van je apparaat wordt altijd gerespecteerd."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଗତି ବଦଳରେ ସ୍ଥିର ସ୍କୋର ଓ ପାଳି ପରିବର୍ତ୍ତନ ଦେଖାଏ। ତୁମ ଡିଭାଇସର ଗତି କମାଅ ସେଟିଂ ସର୍ବଦା ମାନାଯାଏ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਹਿਲਜੁਲ ਦੀ ਥਾਂ ਸਕੋਰ ਅਤੇ ਵਾਰੀ ਦੇ ਬਦਲਾਅ ਸਥਿਰ ਰੂਪ ਵਿੱਚ ਦਿਖਾਉਂਦਾ ਹੈ। ਤੁਹਾਡੇ ਡਿਵਾਈਸ ਦੀ “ਮੋਸ਼ਨ ਘਟਾਓ” ਸੈਟਿੰਗ ਦਾ ਹਮੇਸ਼ਾ ਪਾਲਣ ਹੁੰਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje statyczne zmiany wyniku i tury zamiast ruchu. Ustawienie „Ogranicz ruch” na urządzeniu jest zawsze respektowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra as mudanças de placar e de vez sem movimento. O ajuste Reduzir Movimento do seu dispositivo é sempre respeitado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra as alterações de pontuação e de vez sem movimento. A definição Reduzir movimento do teu dispositivo é sempre respeitada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișează schimbări statice de scor și de tură în loc de mișcare. Opțiunea Reducere mișcare a dispozitivului tău este respectată mereu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает статичные изменения счёта и хода вместо движения. Настройка «Уменьшение движения» на устройстве всегда учитывается."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namiesto pohybu zobrazuje statické zmeny skóre a ťahov. Nastavenie Obmedziť pohyb na tvojom zariadení sa vždy rešpektuje."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namesto gibanja prikazuje statične spremembe rezultata in poteze. Nastavitev Zmanjšaj gibanje na tvoji napravi je vedno upoštevana."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar statisk poäng och turbyten i stället för rörelse. Enhetens inställning Minska rörelse respekteras alltid."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அசைவுக்குப் பதிலாக நிலையான மதிப்பெண் மற்றும் முறை மாற்றங்களைக் காட்டும். உன் சாதனத்தின் இயக்கத்தைக் குறை அமைப்பு எப்போதும் மதிக்கப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కదలికకు బదులుగా స్థిరమైన స్కోరు, వంతు మార్పులను చూపిస్తుంది. మీ పరికరంలోని “కదలికను తగ్గించు” సెట్టింగ్ ఎల్లప్పుడూ పాటించబడుతుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงคะแนนและการเปลี่ยนตาแบบนิ่งแทนการเคลื่อนไหว การตั้งค่าลดการเคลื่อนไหวของอุปกรณ์จะได้รับการเคารพเสมอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hareket yerine skor ve sıra değişikliklerini sabit olarak gösterir. Cihazının Hareketi Azalt ayarına her zaman uyulur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує статичні зміни рахунку й ходу замість руху. Налаштування «Зменшення руху» на пристрої завжди враховується."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرکت کے بجائے اسکور اور باری کی تبدیلیاں ساکن انداز میں دکھاتا ہے۔ آپ کی ڈیوائس کی ”حرکت کم کریں“ سیٹنگ کا ہمیشہ احترام کیا جاتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị điểm và đổi lượt dạng tĩnh thay vì chuyển động. Cài đặt Giảm chuyển động của thiết bị luôn được tôn trọng."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以靜態方式顯示分數和回合變化，而非動畫。一律會遵循裝置的「減少動態效果」設定。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示静态的分数和回合变化，而不是动画。设备的“减弱动态效果”设置始终会被遵循。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以靜態方式顯示分數和回合變化，而非動畫。一律會遵循裝置的「減少動態效果」設定。"
          }
        }
      }
    },
