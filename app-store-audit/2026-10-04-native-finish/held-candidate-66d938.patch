+                }
+            }.frame(width: 448)
+            Text("Classic · \(game.size) × \(game.size)\napps.apple.com/app/id971329310").font(.system(size: 11)).multilineTextAlignment(.center)
+        }.padding(24).frame(width: 512, height: 660).background(MountainStyle.ink).foregroundStyle(MountainStyle.cream)
+    }
+}
